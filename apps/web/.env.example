# Локальний сайт (npm run dev). Скопіюйте в apps/web/.env.local. На сервері змінні задає compose.yaml.

# Адреса CMS: для браузера (фото) і для сервера сайту (запити каталогу).
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_URL=http://localhost:1337
# Необов'язково: токен читання Strapi (каталог і так відкритий публічно).
STRAPI_READ_TOKEN=
# Точна адреса сайту (перевірка, що оформлення надсилається з нашого сайту).
WEB_PUBLIC_URL=http://localhost:3000
# Такий самий, як у apps/cms/.env. Без префікса NEXT_PUBLIC_ — він не має потрапити в браузер.
CHECKOUT_API_SECRET=

# Мапа магазинів (необов'язково; без ключа — вбудована мапа Google).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
