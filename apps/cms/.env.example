# Локальна CMS (npm run develop). Скопіюйте в apps/cms/.env. На сервері змінні задає compose.yaml з кореневого .env.
# Згенерувати випадковий рядок: openssl rand -hex 32

HOST=0.0.0.0
PORT=1337
# Адреси CMS і сайту (LiqPay шле результат оплати на CMS і повертає клієнта на сайт).
PUBLIC_URL=http://localhost:1337
WEB_PUBLIC_URL=http://localhost:3000

# Ключі Strapi: APP_KEYS — чотири випадкові рядки через кому, решта — по одному.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Локально — SQLite у файлі. Перед перемиканням git-гілок зупиняйте Strapi: він видаляє дані полів,
# яких немає в схемі іншої гілки.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Нова Пошта: пошук міст і відділень під час оформлення.
NP_API_KEY=

# Спільний секрет із сайтом (такий самий у apps/web/.env.local), 32+ символів.
CHECKOUT_API_SECRET=
# LiqPay: тестові ключі (sandbox_…) з LIQPAY_TEST_MODE=true. Без ключів картка недоступна.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_TEST_MODE=true

# Telegram менеджера. Для розробки — окремий тестовий бот: один токен не можна опитувати з двох CMS одночасно.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MANAGER_IDS=
