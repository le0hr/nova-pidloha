{
  "kind": "collectionType",
  "collectionName": "product_variations",
  "info": {
    "singularName": "product-variation",
    "pluralName": "product-variations",
    "displayName": "Варіація товару"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "door",
        "floor",
        "hardware"
      ]
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "product_variations"
    },
    "price": {
      "type": "string",
      "required": true,
      "regex": "^(?!0+(\\.0+)?$)\\d+(\\.\\d{1,2})?$"
    },
    "decor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor.decor",
      "inversedBy": "product_variations"
    },
    "decor_color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor-color.decor-color",
      "inversedBy": "product_variations"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "decor_glass": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor-glass.decor-glass",
      "inversedBy": "product_variations",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "construction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::construction.construction",
      "inversedBy": "product_variations",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "opening_side": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::opening-side.opening-side",
      "inversedBy": "product_variations",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "edge": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::edge.edge",
      "inversedBy": "product_variations",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "width": {
      "type": "integer",
      "min": 1,
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "height": {
      "type": "integer",
      "min": 1,
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.variation-option",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "floor"
                ]
              ]
            }
          ]
        }
      }
    },
    "packArea": {
      "type": "float",
      "min": 0,
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "door",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "boardSize": {
      "type": "string",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "door",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "in_stock",
        "on_order"
      ]
    },
    "characteristics": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.characteristic",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "door",
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    },
    "slug": {
      "type": "uid"
    },
    "external_id": {
      "type": "string",
      "unique": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sku": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "supplier_code": {
      "type": "string"
    },
    "filter_values": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::filter-code.filter-code"
    },
    "addons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::architrave-type.architrave-type",
      "conditions": {
        "visible": {
          "!": [
            {
              "in": [
                {
                  "var": "kind"
                },
                [
                  "hardware"
                ]
              ]
            }
          ]
        }
      }
    }
  }
}
