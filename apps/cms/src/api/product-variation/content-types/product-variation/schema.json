{
  "kind": "collectionType",
  "collectionName": "product_variations",
  "info": {
    "singularName": "product-variation",
    "pluralName": "product-variations",
    "displayName": "Варіація товару"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "product_variations"
    },
    "price": {
      "type": "string"
    },
    "decor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor.decor",
      "inversedBy": "product_variations"
    },
    "decor_color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor-color.decor-color",
      "inversedBy": "product_variations"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "decor_glass": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::decor-glass.decor-glass",
      "inversedBy": "product_variations"
    },
    "width": {
      "type": "integer",
      "min": 1
    },
    "height": {
      "type": "integer",
      "min": 1
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.variation-option"
    },
    "packArea": {
      "type": "float",
      "min": 0
    },
    "boardSize": {
      "type": "string"
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "in_stock",
        "on_order"
      ]
    },
    "characteristics": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.characteristic"
    },
    "slug": {
      "type": "uid"
    },
    "external_id": {
      "type": "string",
      "unique": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sku": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "supplier_code": {
      "type": "string"
    },
    "filter_values": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::filter-code.filter-code"
    },
    "addons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::architrave-type.architrave-type"
    }
  }
}
