{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "adresses": {
      "type": "component",
      "component": "shops.adresses",
      "repeatable": true
    },
    "heroEnabled": {
      "type": "boolean",
      "default": true
    },
    "heroSlides": {
      "type": "component",
      "repeatable": true,
      "component": "home.hero-slide"
    },
    "heroMap": {
      "type": "component",
      "repeatable": false,
      "component": "home.hero-map"
    },
    "shopLocations": {
      "type": "component",
      "repeatable": true,
      "component": "shops.location"
    }
  }
}
