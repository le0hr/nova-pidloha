{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "seo",
    "icon": "search",
    "description": "Ручні SEO-правки. Порожні поля сайт заповнює автоматично з назви, ціни й характеристик."
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "openGraph": {
      "type": "component",
      "repeatable": false,
      "component": "shared.open-graph"
    },
    "keywords": {
      "type": "text"
    },
    "metaRobots": {
      "type": "string"
    },
    "metaViewport": {
      "type": "string"
    },
    "canonicalURL": {
      "type": "string"
    },
    "structuredData": {
      "type": "json"
    }
  }
}
