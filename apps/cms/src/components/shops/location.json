    "lng": {
      "type": "decimal",
      "required": true,
      "min": -180,
      "max": 180
    },
    "placeId": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
