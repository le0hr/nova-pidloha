# Copy to .env (chmod 600). Never commit real values.
# Use an immutable release tag, e.g. the Git commit SHA.
IMAGE_TAG=initial
WEB_PUBLIC_URL=https://WEB_DOMAIN
CMS_PUBLIC_URL=https://CMS_DOMAIN
DATABASE_NAME=novapidloha
DATABASE_USERNAME=novapidloha
DATABASE_PASSWORD=
# Four independent random strings separated by commas:
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Server-only, optional if public catalog permissions are configured:
STRAPI_READ_TOKEN=
# Required for Nova Poshta checkout lookup:
NP_API_KEY=
# Defaults are new Nova Pidloha volumes. Change only for an intentional restore.
DB_VOLUME_NAME=novapidloha_postgres_data
UPLOADS_VOLUME_NAME=novapidloha_uploads

# Browser Google Maps key (Maps JavaScript API enabled; restrict to website referrers).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom map ID; otherwise Google DEMO_MAP_ID is used.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Shared server-only secret (32+ random characters), identical in web and CMS.
CHECKOUT_API_SECRET=
# LiqPay keys belong only in CMS. Start with sandbox keys.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_TEST_MODE=true
# Manager notifications in Telegram (CMS only): checkout stages, payments, "confirm" button that captures the hold.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated Telegram user ids allowed to press "confirm" (empty = anyone in the chat).
TELEGRAM_MANAGER_IDS=
