# Сервер (Docker Compose). Скопіюйте в .env поруч із compose.yaml, права 600. Справжні значення не комітьте.
# Згенерувати випадковий рядок: openssl rand -hex 32

# --- Випуск і адреси ---------------------------------------------------------------------------------------
# Тег образів, краще SHA коміту.
IMAGE_TAG=initial
# Точні адреси сайту і CMS. Для оплати карткою потрібен HTTPS (домен + сертифікат).
WEB_PUBLIC_URL=https://WEB_DOMAIN
CMS_PUBLIC_URL=https://CMS_DOMAIN

# --- База даних (PostgreSQL у compose) ------------------------------------------------------------------------
DATABASE_NAME=novapidloha
DATABASE_USERNAME=novapidloha
DATABASE_PASSWORD=
# Томи з даними. Змінюйте лише при свідомому відновленні з іншого тому.
DB_VOLUME_NAME=novapidloha_postgres_data
UPLOADS_VOLUME_NAME=novapidloha_uploads

# --- Ключі Strapi (кожен — окремий випадковий рядок) -----------------------------------------------------------
# Чотири рядки через кому.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Каталог і доставка ----------------------------------------------------------------------------------------
# Необов'язково: токен читання Strapi для сайту (каталог і так відкритий публічно).
STRAPI_READ_TOKEN=
# Нова Пошта: пошук міст і відділень під час оформлення.
NP_API_KEY=

# --- Мапа магазинів (необов'язково; без ключа показується вбудована мапа Google) --------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Оформлення замовлень і оплата -----------------------------------------------------------------------------
# Онлайн-оформлення замовлень на сайті. false = кошик працює, а замість «Оформити» — «скоро» і телефон.
# Вмикайте (true) лише коли підключені LiqPay і Telegram та є HTTPS. Перезбирання не потрібне — лише перезапуск web.
CHECKOUT_ENABLED=false
# Спільний секрет сайту і CMS, 32+ символів (openssl rand -hex 32).
CHECKOUT_API_SECRET=
# LiqPay: кабінет → Налаштування → API. Тестовий публічний ключ починається з sandbox_ → LIQPAY_TEST_MODE=true;
# робочі ключі → LIQPAY_TEST_MODE=false. Без ключів картка недоступна, накладений платіж і рахунок працюють.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_TEST_MODE=true

# --- Telegram менеджера: етапи оформлення, оплата, кнопки «Підтвердити» / «Скасувати» ---------------------------
# Токен від @BotFather. Один токен — лише на одному сервері (бот опитується, webhook не потрібен).
TELEGRAM_BOT_TOKEN=
# Id чату або групи менеджерів (бот має бути її учасником; у групи id від'ємний).
TELEGRAM_CHAT_ID=
# Необов'язково: id користувачів через кому, яким можна натискати кнопки (порожньо = всім у чаті).
TELEGRAM_MANAGER_IDS=
